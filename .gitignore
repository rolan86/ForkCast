# OS
.DS_Store
Thumbs.db

# macOS/Finder copy artifacts ("foo 2.py", ".venv 2/"). These are byte-identical
# duplicates that reappear on iCloud or Finder copy and must never be committed;
# a stray duplicate module inside src/ is especially confusing.
* 2.*
* 2/

# Superpowers
.superpowers/
docs/superpowers/
**/docs/superpowers/

# Use cases — tracked (linked from README)
# docs/use-cases/

# Python virtualenv
.venv/

# Test / coverage
.pytest_cache/
htmlcov/
.coverage

# Evolution notes (private observations)
evolution/

# uv lock
uv.lock

# Git worktrees
.worktrees/

# Logs
log/

# Root-level npm artifacts (frontend deps belong in frontend/)
/node_modules/
/package.json
/package-lock.json

# Frontend
frontend/node_modules/
frontend/dist/

# Render output. Multi-megabyte mp4s plus a composition scaffold with its own
# node_modules. Marketing and launch assets live outside this repo; these
# patterns stay as a guard so a render cannot deposit them back into it.
brag-output/
brag-output-*/
