# macOS/Finder copy artifacts ("foo 2.py", ".venv 2/"). These are byte-identical
# duplicates that reappear on iCloud or Finder copy and must never be committed;
# a stray duplicate module inside src/ is especially confusing.
* 2.*
* 2/

# Superpowers
.superpowers/
docs/superpowers/
**/docs/superpowers/

# Use cases — tracked (linked from README)
# docs/use-cases/

# Python virtualenv
.venv/

# Test / coverage
.pytest_cache/
htmlcov/
.coverage

# Evolution notes (private observations)
evolution/

# uv lock
uv.lock

# Git worktrees
.worktrees/

# Logs
log/

# Root-level npm artifacts (frontend deps belong in frontend/)
/node_modules/
/package.json
/package-lock.json

# Frontend
frontend/node_modules/
frontend/dist/

# /brag render output. Multi-megabyte mp4s plus a Remotion composition scaffold
# with its own node_modules. The videos are launch assets, not source; they get
# uploaded to the platform directly and must never enter git history.
# Moved out 2026-08-09 to dmello-advisory-hq (private), which is where launch
# assets and their copy now live. These patterns stay as a guard so a future
# /brag run cannot deposit marketing material back into a public repo.
brag-output/
brag-output-*/
